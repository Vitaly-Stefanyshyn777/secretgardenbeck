generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String   @unique
  password  String
  phone     String?
  instagram String?
  telegram  String?
  firstname String?
  lastname  String?
  role      Role
  posts     Post[]
  orders    Order[]
  reviews   Review[]
  viewedProducts UserViewedProduct[]
  cartItems     CartItem[]
  wishlist      UserWishlist[]
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
}

model UserWishlist {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([userId, productId])
}

model UserViewedProduct {
  userId    String   // зовнішній ключ на користувача
  productId String   // зовнішній ключ на товар
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([userId, productId])
}

model Post {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  published Boolean
  title     String
  content   String?
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
}

model Category {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  name      String
  slug      String      @unique
  parentId  String?
  parent    Category?   @relation("CategoryToSubcategories", fields: [parentId], references: [id])
  children  Category[]  @relation("CategoryToSubcategories")
  products  ProductCategory[]
  filters   CategoryFilter[]
}

model CategoryFilter {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  name       String   // Тип, Матеріал, Виробник
  slug       String   // type, material, manufacturer (для query-параметрів)
  order      Int      @default(0)
  values     CategoryFilterValue[]
}

model CategoryFilterValue {
  id           String   @id @default(cuid())
  filterId     String
  filter       CategoryFilter @relation(fields: [filterId], references: [id])
  value        String   // RAW, Phoenix, Backwoods
  slug         String   // raw, phoenix, backwoods (унікальний в межах фільтра)
  order        Int      @default(0)
  productLinks ProductFilterValue[]

  @@unique([filterId, slug])
}

model Product {
  id             String            @id @default(cuid())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  name           String
  slug           String            @unique
  price          Decimal
  currency       String            @default("UAH")
  shortDescription String?
  description    String?
  inStock        Boolean           @default(true)
  stockQuantity  Int?              // null = не ведемо складський облік
  mainImageUrl   String?
  // для вітрини типу "CBD масло", "CBD WAX" і т.п.
  label          String?           // виводимо як заголовок картки, якщо треба відрізняти від name

  // зв’язки
  categories         ProductCategory[]
  orderItems         OrderItem[]
  reviews            Review[]
  characteristics    ProductCharacteristic[]
  filterValues       ProductFilterValue[]
  descriptionBlocks  ProductDescriptionBlock[]
  viewedBy           UserViewedProduct[]
  cartItems          CartItem[]
  wishlist           UserWishlist[]
  ratingAverage      Float?   @default(0)
  ratingCount        Int      @default(0)
}

model ProductDescriptionBlock {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String   // paragraph | list | heading
  content   String?  // текст для paragraph/heading
  items     Json?    // масив рядків для type=list
  order     Int      @default(0)
}

model ProductFilterValue {
  productId     String
  filterValueId String
  product       Product @relation(fields: [productId], references: [id])
  filterValue   CategoryFilterValue @relation(fields: [filterValueId], references: [id])
  @@id([productId, filterValueId])
}

model ProductCharacteristic {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  name      String   // назва характеристики, напр. "Кількість капсул в упаковці"
  value     String   // значення, напр. "60 капсул"
  order     Int      @default(0) // порядок виводу
}

model ProductCategory {
  productId  String
  categoryId String

  product Product  @relation(fields: [productId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
}

model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  items     OrderItem[]
  total     Decimal
  status    String   @default("NEW")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal  // ціна на момент покупки
}

model Review {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  rating     Int
  title      String?
  text       String?
  authorName String?
}

enum Role {
  ADMIN
  USER
}
