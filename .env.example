# POSTGRES
POSTGRES_USER=prisma
POSTGRES_PASSWORD=topsecret
POSTGRES_DB=blog

# Nest run locally
DB_HOST=localhost
# Nest run in docker, change host to database container name
# DB_HOST=postgres
DB_PORT=5432
DB_SCHEMA=blog

# Prisma database connection
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}?schema=${DB_SCHEMA}&sslmode=prefer

# Nest
PORT=3000

# Security
JWT_ACCESS_SECRET=nestjsPrismaAccessSecret
JWT_REFRESH_SECRET=nestjsPrismaRefreshSecret

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Order email notify (Resend)
ORDER_NOTIFY_EMAIL=vetalstefan167@gmail.com
RESEND_API_KEY=
MAIL_FROM=Secret Garden <onboarding@resend.dev>

# Інтернет-еквайринг Райффайзен Банку (параметри з договору / кабінету банку)
RAIFFEISEN_MERCHANT_ID=
RAIFFEISEN_SECRET_KEY=
RAIFFEISEN_CHECKOUT_URL=https://pay.raiffeisen.ua/api/payment/create
RAIFFEISEN_RESULT_URL=http://localhost:3001/order-success
RAIFFEISEN_SERVER_URL=http://localhost:3000/api/raiffeisen/callback
# sha1hmac (HMAC-SHA256) | sha1concat (SHA1 secret+raw+secret)
RAIFFEISEN_SIGN_MODE=sha1hmac
